#jinja2: lstrip_blocks: True
[Unit]
Description=Photo Frame service
After=graphical.target
After=remote-fs.target
{% if photo_frame_nfs_mount != none and not photo_frame_rsync %}
BindsTo={{ photo_frame_mount }}.mount
After={{ photo_frame_mount }}.mount
{% endif %}

[Service]
User={{ photo_frame_user }}
Group={{ photo_frame_group }}
Environment=WAYLAND_DISPLAY={{ photo_frame_display }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ photo_frame_uid }}
{% if photo_frame_rotate != none %}
ExecStartPre=-/usr/bin/wlr-randr --output {{ photo_frame_output }} --transform {{ photo_frame_rotate }}
{% endif %}
ExecStart={{ photo_frame_command }}
Type=simple
Restart=always

[Install]
WantedBy=graphical.target
